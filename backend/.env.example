# Chave do Gemini (https://aistudio.google.com/apikey). So o backend usa.
GEMINI_API_KEY=coloque_sua_chave_do_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash

# Chave que o jogo precisa mandar no header X-API-Key (invente uma).
API_KEY=troque-por-uma-chave-secreta

# Origens liberadas no CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:8501
